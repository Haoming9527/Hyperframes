# Copy values into CMD with `set` (see README / AGENTS.md).
# HyperFrames does NOT auto-load this file — renaming to .env is optional/reference only.
# Do not download Chromium — use the Chrome installed on this PC.

HYPERFRAMES_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PRODUCER_HEADLESS_SHELL_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
HYPERFRAMES_FFMPEG_PATH=%CD%\vendor\ffmpeg\bin\ffmpeg.exe
HYPERFRAMES_FFPROBE_PATH=%CD%\vendor\ffmpeg\bin\ffprobe.exe
HYPERFRAMES_NO_TELEMETRY=1
HYPERFRAMES_SKIP_SKILLS=1
